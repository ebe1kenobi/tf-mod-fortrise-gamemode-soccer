<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ModLoaderPath>C:\Program Files (x86)\Steam\steamapps\common\TowerFall\FortRise</ModLoaderPath>

    <ModVersion>1.0.0</ModVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FortRise.Configuration" Version="1.5.6" />
  </ItemGroup>

  <!-- meta.json + Content/ (icone du mode, ballon) doivent etre copies dans la
       sortie, sinon la publication automatique n'embarque que la dll : FortRise ne
       reconnait pas le mod et les textures ne se chargent pas. -->
  <ItemGroup>
    <Content Include="../ModFile/**/*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
